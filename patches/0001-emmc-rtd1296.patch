+static int rtk_pinctrl_select(struct dw_mci_rtkemmc_host *priv,
+			      struct pinctrl_state *state)
+{
+	struct pinctrl *p = priv->pinctrl;
+
+	if (IS_ERR_OR_NULL(p) || IS_ERR_OR_NULL(state))
+		return 0;
+
+	return pinctrl_select_state(p, state);
+}
