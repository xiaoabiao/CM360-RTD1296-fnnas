diff --git a/drivers/phy/realtek/phy-rtk-sata.c b/drivers/phy/realtek/phy-rtk-sata.c
index b2808c6b4..da33ea848 100644
--- a/drivers/phy/realtek/phy-rtk-sata.c
+++ b/drivers/phy/realtek/phy-rtk-sata.c
@@ -7,6 +7,7 @@
 
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/io.h>
 #include <linux/of_address.h>
 #include <linux/of_device.h>
 #include <linux/clk.h>
@@ -38,7 +39,12 @@
 #define REG_PHY0_ADJ		0x28
 #define REG_PHY1_ADJ		0x2C
 
-#define REG_MDIO_CTRL		0x60
+/* CM360 板级补丁（2026-10-04，第四版）：MDIO 端口地址对齐 kylin 实证布局。
+ * 4.9（DSM，同芯片实证能点亮）的引擎在 base+0x00（命令）/ +0x04（index）/
+ * +0x08（speed）；6.6 的 0x60/0x64/0x68 是新 SoC 的布局，kylin 上写 0x60
+ * 全部落空（busy 恒 0、无声失败，实测 SStatus 0）。两代命令字编码相同
+ * （addr<<14 | reg<<8 | data<<16 | RDY | WRITE），只有端口地址不同。 */
+#define REG_MDIO_CTRL		0x00
 #define MDIO_REG_SHIFT		8
 #define MDIO_PHYADDR_SHIFT	14
 #define MDIO_DATA_SHIFT		16
@@ -48,8 +54,8 @@
 
 #define TCALR_MSK		GENMASK(4, 0)
 
-#define REG_MDIO_CTRL1		0x64
-#define REG_PHY_SPD		0x68
+#define REG_MDIO_CTRL1		0x04
+#define REG_PHY_SPD		0x08
 
 #define OOBS_K_count_limit   9
 
@@ -155,6 +161,8 @@ static int write_mdio_reg(void __iomem *base, unsigned int phyaddr,
 			      (reg << MDIO_REG_SHIFT) |
 			      MDIO_RDY | MDIO_WRITE;
 			writel(val, base + REG_MDIO_CTRL);
+			/* kylin 引擎无 busy 反馈可用，4.9 用 mdelay(1) 定拍 */
+			mdelay(1);
 
 			if (mdio_wait_busy(base))
 				goto mdio_busy;
@@ -165,6 +173,7 @@ static int write_mdio_reg(void __iomem *base, unsigned int phyaddr,
 		      (reg << MDIO_REG_SHIFT) |
 		      MDIO_RDY | MDIO_WRITE;
 		writel(val, base + REG_MDIO_CTRL);
+		mdelay(1);
 	}
 
 	return 0;
@@ -183,6 +192,7 @@ read_mdio_reg(void __iomem *base, unsigned int phyaddr, unsigned int reg)
 
 	addr = (phyaddr << MDIO_PHYADDR_SHIFT) | (reg << MDIO_REG_SHIFT);
 	writel(addr | MDIO_RDY, base + REG_MDIO_CTRL);
+	mdelay(1);
 
 	if (mdio_wait_busy(base))
 		goto mdio_busy;
@@ -442,6 +452,22 @@ static int rtk_sata_phy_init(struct phy *phy)
 	size_t buf_size;
 	int i, swing[PHY_ADDR_ALL], emphasis[PHY_ADDR_ALL], ibtx[PHY_ADDR_ALL];
 
+	/* CM360 板级补丁（2026-10-04，第三版）：SB2 使能位提前到 MDIO 之前。
+	 * 厂商 4.9 phy-rtk-sata.c phy_rtk_sata_init() 的顺序是：
+	 *   ① SB2 位（0x9801A980：port0=BIT0|2|4|8，port1=BIT1|3|5）
+	 *   ② MDIO 参数表
+	 * 而 6.6 把 kylin 的 SB2 写放进了 power_on()（MDIO 之后）。非 kylin
+	 * 路径（REG_PHY_CTRL）反而是先使能再写 MDIO。若 SB2 位是 PHY 寄存器
+	 * 访问的桥开关，kylin 的 MDIO 写会全部落空 → SStatus 0（实测现象）。
+	 * 对齐 4.9：init 一进来就开桥。power_on 里那遍保留（位幂等）。 */
+	if (soc_device_match(rtk_soc_kylin)) {
+		reg_phy_ctrl = REG_SB2_PHY_CTRL;
+		phy_en = ((BIT(0) | BIT(2) | BIT(4)) << port->index) | BIT(8);
+		regmap_read(priv->phyctl, reg_phy_ctrl, &reg);
+		phy_en |= reg;
+		regmap_update_bits(priv->phyctl, reg_phy_ctrl, phy_en, phy_en);
+	}
+
 	for (i = 0; i < PHY_MAX_RST; i++) {
 		if (IS_ERR(port->rsts[i]))
 			break;
@@ -608,6 +634,14 @@ static int rtk_sata_phy_init(struct phy *phy)
 		}
 	}
 
+	/* CM360 板级补丁：4.9 序列最后一步——官方 1296 overlay 未设
+	 * speed-limit → speed==0 → base+8 = 0xA（writel_delay 定拍）。
+	 * 6.6 kylin 路径漏了这一写。 */
+	if (soc_device_match(rtk_soc_kylin)) {
+		writel(0xA, base + REG_PHY_SPD);
+		mdelay(1);
+	}
+
 	return 0;
 }
 
@@ -675,7 +709,6 @@ static int rtk_sata_phy_probe(struct platform_device *pdev)
 	struct device_node *child;
 	struct rtk_sata_phy *priv;
 	struct phy_provider *phy_provider;
-	struct resource *res;
 	unsigned int idx = 0;
 	int i;
 
@@ -686,11 +719,26 @@ static int rtk_sata_phy_probe(struct platform_device *pdev)
 	priv->dev = dev;
 	dev_set_drvdata(dev, priv);
 
-	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
-	priv->base = devm_ioremap_resource(dev, res);
-	if (IS_ERR(priv->base)) {
-		dev_err(dev, "failed to remap phy base regs\n");
-		return PTR_ERR(priv->base);
+	/* CM360 板级补丁（2026-10-04，第二版）：本节点 reg（0x9803FF60..+0xFF）
+	 * 官方布局上落在 AHCI 节点 reg（0x9803F000..0x9803FFFF）内 —— 两个
+	 * 驱动谁先 request_mem_region 谁赢，另一个 EBUSY（实测 phy 先 probe
+	 * 时 ahci 报 "can't request region ... failed with error -16"）。
+	 * 重叠是官方设计（sata-wrap syscon 与 PHY MDIO 寄存器共用同一 256B
+	 * 块），所以这里必须【只映射、不申请】：devm_ioremap_resource 和
+	 * devm_of_iomap 内部都会 request（第一版就栽在这），改 devm_ioremap。
+	 * 本驱动无 .remove，devm 管理的生命周期足够。 */
+	{
+		struct resource pres;
+
+		if (of_address_to_resource(node, 0, &pres)) {
+			dev_err(dev, "failed to get phy base regs\n");
+			return -EINVAL;
+		}
+		priv->base = devm_ioremap(dev, pres.start, resource_size(&pres));
+		if (!priv->base) {
+			dev_err(dev, "failed to remap phy base regs\n");
+			return -ENOMEM;
+		}
 	}
 
 	priv->phyctl = syscon_regmap_lookup_by_phandle(node, "realtek,phyctl");
