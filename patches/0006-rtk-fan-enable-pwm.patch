diff --git a/drivers/soc/realtek/common/rtk_fan.c b/drivers/soc/realtek/common/rtk_fan.c
index 594ed0b70..dea52b054 100644
--- a/drivers/soc/realtek/common/rtk_fan.c
+++ b/drivers/soc/realtek/common/rtk_fan.c
@@ -143,6 +143,11 @@ static int rtk_fan_ctrl_speed(struct rtk_fan_data *fan_data, int ctrl_speed) {
 		int duty_ns = period_ns * ctrl_speed / MAX_CTRL_SPEED;
 		dev_dbg(fan_data->dev, "%s to set pwm default duty_ns =%d,  period_ns = %d!",
 		__func__, duty_ns, period_ns);
+		/* CM360: 原驱动只改占空比、从不 enable。新内核 PWM 框架在
+		 * "通道 disabled" 状态下 pwm_config() 会直接把新状态丢掉
+		 * （pwm-rtk.c 的 apply 在 !state->enabled 时提前 return），
+		 * 结果就是写任何转速风扇都毫无反应。这里补一次 pwm_enable()。 */
+		pwm_enable(fan_data->pwm);
 		pwm_config(fan_data->pwm, duty_ns, period_ns);
 	}
 	fan_data->ctrl_speed = ctrl_speed;
@@ -321,8 +326,20 @@ static int rtk_fan_init(struct rtk_fan_data *fan_data, struct platform_device *p
 	/* GET reset controller */
 	struct reset_control *reset_fan = reset_control_get_exclusive(dev, NULL);
 
-	reset_control_deassert(reset_fan);
-	clk_prepare_enable(clk_fan);
+	/* CM360: 设备树里没有 clocks/resets 属性时上面两个 get 返回 ERR_PTR，
+	 * 原驱动不做检查就直接 deassert/prepare_enable —— 会 oops 并让内核 panic
+	 * （实测 pc=clk_prepare lr=rtk_fan_probe）。这里改成"拿不到就跳过"：
+	 * 本板的扇热时钟/复位由 u-boot 与 SoC 默认状态提供，实测可正常工作。 */
+	if (!IS_ERR(reset_fan)) {
+		reset_control_deassert(reset_fan);
+	} else {
+		dev_info(dev, "no reset control in DT, skip deassert\n");
+	}
+	if (!IS_ERR(clk_fan)) {
+		clk_prepare_enable(clk_fan);
+	} else {
+		dev_info(dev, "no clock in DT, skip prepare_enable\n");
+	}
 
 	ret = of_property_read_u32(node, "fan_debounce",
 					&fan_debounce);
