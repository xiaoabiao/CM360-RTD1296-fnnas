-- memory / chosen --

	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x7ffe1000>;
	};

	aliases {
		serial0 = "/soc@0/bus@98000000/syscon@7000/serial@800";
	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200 earlycon=uart8250,mmio32,0x98007800,115200 loglevel=8 ignore_loglevel";
	};
};
