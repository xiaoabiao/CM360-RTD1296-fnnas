-- watchdog --
				watchdog@680 {
					compatible = "realtek,rtd1295-watchdog";
					reg = <0x680 0x100>;
					clocks = <0x06>;
					status = "disabled";
-- uart0 --
				serial@800 {
					compatible = "snps,dw-apb-uart";
					reg = <0x800 0x400>;
					reg-shift = <0x02>;
					reg-io-width = <0x04>;
					clock-frequency = <0x19bfcc0>;
					resets = <0x07 0x08>;
					status = "okay";
--
		serial0 = "/soc@0/bus@98000000/syscon@7000/serial@800";
	};

	chosen {
		stdout-path = "serial0:115200n8";
